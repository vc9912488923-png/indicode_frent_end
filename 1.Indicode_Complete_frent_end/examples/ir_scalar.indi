record Point {
    x: Int,
    y: Int
}

answer = 42

function add(left: Int, right: Int) -> Int {
    let result: Int = left + right
    return result
}

function below(left: Int2, right: Int2) -> Bool {
    return left < right
}

function signed_divide(left: Long, right: Long) -> Long {
    return left / right
}

function unsigned_remainder(left: ULong, right: ULong) -> ULong {
    return left % right
}

function bitwise_not(value: Int) -> Int {
    return ~value
}

function invert(value: Bool) -> Bool {
    return !value
}

function choose(value: Bool) -> Int {
    if value {
        return 1
    } else {
        return 0
    }
}

function countdown(start: Int) -> Int {
    var current: Int = start
    while current > 0 {
        current = current - 1
    }
    return current
}

function implicit_local() -> Int {
    value = 2
    value = value + 3
    return value
}

function both(left: Bool, right: Bool) -> Bool {
    return left && right
}

function either(left: Bool, right: Bool) -> Bool {
    return left || right
}

function call_named(value: Int) -> Int {
    return add(right: 4, left: value)
}

function done(value: Int) {
    return
}

function invoke(value: Int) {
    done(value)
}

function float_sum(left: Float, right: Float) -> Float {
    return left + right
}

function half_sum(left: Half, right: Half) -> Half {
    return left + right
}

function below_float(left: Double, right: Double) -> Bool {
    return left < right
}

function float_literal() -> Float {
    return 1.25
}

function converted(input: Int) -> Long {
    return to_Long(input, checked: true)
}

function announces(value: Int) {
    say(value)
}

function make_point(x: Int) -> Point {
    return Point(y: 2, x: x)
}

function point_x(point: Point) -> Int {
    return point.x
}

function first_item(values: List<Int>) -> Int {
    return values[0]
}

function make_items() -> List<Int> {
    return [1, 2, 3]
}

function first_char(text: Text) -> Char {
    return text[0]
}

function same_text(left: Text, right: Text) -> Bool {
    return left == right
}

function text_before(left: Text, right: Text) -> Bool {
    return left <= right
}

function char_before(left: Char, right: Char) -> Bool {
    return left < right
}

function greeting() -> Text {
    return "hello\nworld"
}

function preserve_tensor(input: Tensor<Float, [Batch, 3]>) -> Tensor<Float, [Batch, 3]> {
    return input
}

function range_total() -> Int {
    var total: Int = 0
    for index in 0..5 {
        total = total + index
    }
    return total
}

function repeat_total(count: Int) -> Int {
    var total: Int = 0
    repeat count times {
        total = total + 1
    }
    return total
}

function list_total(values: List<Int>) -> Int {
    var total: Int = 0
    for item in values {
        total = total + item
    }
    return total
}

function print_chars(text: Text) {
    for character in text {
        say(character)
    }
}